# Copy to .env and set your own PIN (never commit .env).
HOST=127.0.0.1
PORT=8000
CAMERA_SOURCE=1
# Set 1 only for offline UI/alert demonstrations. Uses separate demo_monitor.db.
DEMO_MODE=0
ADMIN_PIN=replace-with-a-private-long-pin

# Existing models in the YOLO-Seeun branch. 'none' disables generic COCO.
YOLO_MODEL=yolov8n.pt
# If left empty, auto-loads ../yolo_lab/models/safety7.pt when present.
CUSTOM_YOLO_MODEL=
# Robot class does NOT exist in safety7. Leave empty until validated training.
ROBOT_YOLO_MODEL=
# Only show selected general COCO classes, keep safety7 7 classes.
COCO_LABELS=person,stop sign
ENABLE_YOLO=1
DETECTION_CONF=0.35

# Unknown proposals: changed regions persisting at same position (not YOLO unknown class)
DIFF_THRESHOLD=44
UNKNOWN_MIN_AREA=950
UNKNOWN_STABLE_FRAMES=9
UNKNOWN_TRACK_IOU=0.70
UNKNOWN_COOLDOWN_SEC=100

# Fixed camera monitor boundary; blank = all pixels. Set polygon after camera installed.
# Example: MONITOR_ROI=0.12,0.18;0.90,0.18;0.94,0.91;0.08,0.91
MONITOR_ROI=
FRAME_WIDTH=960
YOLO_IMGSZ=960
YOLO_EVERY_N_FRAMES=3
